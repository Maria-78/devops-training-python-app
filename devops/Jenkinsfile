/**
 * Función reutilizable para ejecutar un bloque de código dentro de un contenedor Docker.
 * @param image El nombre de la imagen Docker a utilizar (ej: 'python:3.6-slim').
 * @param body El bloque de código (Closure) a ejecutar dentro del contenedor.
 */
def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

// Define el pipeline de CI/CD completo.
pipeline {
  // Define el agente por defecto. 'any' significa que Jenkins puede usar cualquier agente disponible.
  agent any

  // Contiene la secuencia de todos los stages que se ejecutarán.
  stages {

    // Stage 1: Muestra información básica sobre la ejecución.
    stage('Info') {
      steps {
        sh 'echo "Job: ${JOB_NAME}"'
        sh 'echo "Build: ${BUILD_NUMBER}"'
      }
    }

    // Stage 2: Construye la imagen Docker de la aplicación.
    stage('Build image') {
        steps {
            // El bloque 'script' permite usar código Groovy más complejo.
            script {
                // Define un nombre único para la imagen usando el número de build.
                def imageName = "my-python-app:${env.BUILD_NUMBER}"
                echo "Building and tagging image: ${imageName}"
                // Ejecuta 'docker build' para crear la imagen.
                docker.build(imageName, "-f devops/Dockerfile .")
            }
        }
    }

    // Stage 3: Verifica la calidad y el formato del código.
    stage('Lint') {
      steps {
        // Usa la función reutilizable para ejecutar los pasos en un contenedor.
        runInDocker('python:3.6-slim') {
          sh '''
            # Instala dependencias del sistema y de Python.
            apt-get update && apt-get install -y make python3-venv gcc libpq-dev
            python3 -m venv .venv
            .venv/bin/pip install --upgrade pip
            .venv/bin/pip install -r requirements.txt
            
            # Arregla el formato y luego verifica que todo esté correcto.
            make reformat
            make lint
          '''
        }
      }
    }

    // Stage 4: Ejecuta las pruebas unitarias.
    stage('Test') {
      steps {
        // Usa la misma función para mantener la consistencia.
        runInDocker('python:3.6-slim') {
          sh '''
            # Instala dependencias del sistema y de Python.
            apt-get update && apt-get install -y make python3-venv gcc libpq-dev
            python3 -m venv .venv
            .venv/bin/pip install --upgrade pip
            .venv/bin/pip install -r requirements.txt
            make reformat
            make test
          '''
        }
      }
    }


stage('CD') {
    steps {
        // 1. Levanta los contenedores en segundo plano
        sh 'docker compose up -d'
        
        // 2. Espera activa (Crucial para que la DB esté lista)
        echo "Esperando a que la base de datos y Flask inicien..."
        sh 'sleep 15'
        
        // 3. Verificación de salud (Healthcheck)
        // Usamos el puerto 5001 porque es el que definiste en el host en tu docker-compose
        script {
            try {
                // Verificación interna: 
                // Usamos 'exec' para que el comando corra DENTRO del contenedor 'app'.
                // Aquí usamos localhost:5000 porque estamos dentro del contenedor.
                sh 'docker compose exec -T app curl -f http://localhost:5000/'
                echo "¡Despliegue exitoso! La aplicación responde."
            } catch (Exception e) {
                echo "Error: La aplicación no responde. Revisando logs..."
                sh 'docker compose logs app'
                error("Fallo en la prueba de conexión (Curl)")
            }
        }
    }
    post {
        // Limpieza de recursos pase lo que pase
        always {
            sh 'docker compose down --volumes'
        }
    }
}

  }
}