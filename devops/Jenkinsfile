/*
  Practica 2 - Jenkinsfile dummy (PUNTO DE PARTIDA)
*/

pipeline {
  agent any

  stages {

    stage('Lint') {
      agent {
        docker {
          image 'python:3.6-slim'
        }
      }
      steps {
        sh 'apt-get update'
        sh 'apt-get install -y make'
        sh 'make lint'
      }
    }

    stage('Test') {
      agent {
        docker {
          image 'python:3.6-slim'
        }
      }
      steps {
        sh 'python --version'
        sh 'pip install pytest'
        sh 'pytest'
      }
    }

    stage('Info') {
      steps {
        sh 'echo "Job: ${JOB_NAME}"'
        sh 'echo "Build: ${BUILD_NUMBER}"'
      }
    }

  }
}