pipeline {
  agent any

  stages {

    stage('Info') {
      steps {
        sh 'echo "Job: ${JOB_NAME}"'
        sh 'echo "Build: ${BUILD_NUMBER}"'
      }
    }

    stage('Lint') {
      agent {
        docker {
          image 'python:3.6-slim'
        }
      }
      steps {
        sh '''
          # Actualizar paquetes e instalar make y venv
          apt-get update && apt-get install -y make python3-venv
          
          # Crear entorno virtual si no existe
          python3 -m venv .venv
          
          # Activar y actualizar pip
          .venv/bin/pip install --upgrade pip
          
          # Instalar herramientas necesarias
          .venv/bin/pip install black flake8 mypy pytest coverage
          
          # Ejecutar Makefile
          make lint
        '''
      }
    }

    stage('Test') {
      agent {
        docker {
          image 'python:3.6-slim'
        }
      }
      steps {
        sh '''
          apt-get update && apt-get install -y make python3-venv
          python3 -m venv .venv
          .venv/bin/pip install --upgrade pip
          .venv/bin/pip install black flake8 mypy pytest coverage
          make test
        '''
      }
    }

  }
}