pipeline {
  agent any

  stages {

    stage('Info') {
      steps {
        sh 'echo "Job: ${JOB_NAME}"'
        sh 'echo "Build: ${BUILD_NUMBER}"'
      }
    }

    stage('Test') {
      agent {
        docker {
          image 'python:3.6-slim'
        }
      }
      steps {
        sh '''
          apt-get update && apt-get install -y make python3-venv
          python3 -m venv .venv
          . .venv/bin/activate
          pip install --upgrade pip
          pip install pytest
          pytest
        '''
      }
    }

   

  }
}