def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

pipeline {
  agent any

  stages {

    stage('Info') {
      steps {
        sh 'echo "Job: ${JOB_NAME}"'
        sh 'echo "Build: ${BUILD_NUMBER}"'
      }
    }

    stage('Build image') {
        steps {
            script {
                def imageName = "my-python-app:${env.BUILD_NUMBER}"
                echo "Building and tagging image: ${imageName}"
                docker.build(imageName, "-f devops/Dockerfile .")
            }
        }
    }

    stage('Lint') {
      steps {
        runInDocker('python:3.6-slim') {
          sh '''
            apt-get update && apt-get install -y make python3-venv
            python3 -m venv .venv
            .venv/bin/pip install --upgrade pip
            .venv/bin/pip install black flake8 mypy
            # Fix formatting before checking
            make reformat
            make lint
          '''
        }
      }
    }

    stage('Test') {
      steps {
        runInDocker('python:3.6-slim') {
          sh '''
            apt-get update && apt-get install -y make python3-venv
            python3 -m venv .venv
            .venv/bin/pip install --upgrade pip
            .venv/bin/pip install pytest coverage
            # Fix formatting before checking
            make reformat
            make test
          '''
        }
      }
    }

   

  }
}